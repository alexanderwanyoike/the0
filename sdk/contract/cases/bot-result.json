{
  "description": "result(value) writes the value as the result, unchanged.",
  "entrypoint": "bot",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}"
  },
  "script": [
    {
      "op": "result",
      "value": {
        "status": "success",
        "message": "Analysis complete",
        "signals": [{"symbol": "BTC/USD", "direction": "long", "confidence": 0.85}],
        "dry_run": false
      }
    }
  ],
  "expect": {
    "exit_code": 0,
    "stdout": [],
    "stderr": [],
    "result": {
      "status": "success",
      "message": "Analysis complete",
      "signals": [{"symbol": "BTC/USD", "direction": "long", "confidence": 0.85}],
      "dry_run": false
    }
  }
}
