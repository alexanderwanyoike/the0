{
  "description": "Each result call replaces the file, so the bot's last call wins.",
  "entrypoint": "bot",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}"
  },
  "script": [
    {"op": "success", "message": "first"},
    {"op": "result", "value": {"status": "success", "message": "second", "step": 2}},
    {"op": "success", "message": "final"}
  ],
  "expect": {
    "exit_code": 0,
    "stdout": [],
    "stderr": [],
    "result": {"status": "success", "message": "final"}
  }
}
