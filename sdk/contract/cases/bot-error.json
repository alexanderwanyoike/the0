{
  "description": "error(message) writes an error result, prints the message as an error log line on stderr, and exits 1 without running anything after it.",
  "entrypoint": "bot",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}"
  },
  "script": [
    {"op": "error", "message": "Broker rejected the order"},
    {"op": "success", "message": "never written"}
  ],
  "expect": {
    "exit_code": 1,
    "stdout": [],
    "stderr": [
      {
        "level": "error",
        "message": "Broker rejected the order",
        "timestamp": {"$match": "timestamp"}
      }
    ],
    "result": {"status": "error", "message": "Broker rejected the order"}
  }
}
