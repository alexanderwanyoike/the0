{
  "description": "Built-in /info lists every path the bot answers, the built-ins included.",
  "entrypoint": "query",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}",
    "QUERY_PATH": "/info"
  },
  "handlers": {
    "/portfolio": [{"op": "return", "value": {}}],
    "/signals": [{"op": "return", "value": []}]
  },
  "expect": {
    "exit_code": 0,
    "query_result": {
      "status": "ok",
      "data": {
        "available_queries": {
          "$match": "unordered",
          "items": ["/portfolio", "/signals", "/health", "/info"]
        }
      }
    }
  }
}
