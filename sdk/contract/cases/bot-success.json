{
  "description": "success(message) writes a success result and the bot exits 0.",
  "entrypoint": "bot",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}"
  },
  "script": [{"op": "success", "message": "Bought 0.5 BTC"}],
  "expect": {
    "exit_code": 0,
    "stdout": [],
    "stderr": [],
    "result": {"status": "success", "message": "Bought 0.5 BTC"}
  }
}
