{
  "description": "log(message, data?, level?) prints one JSON line on stderr: level (info by default), message, the data fields and a UTC ISO 8601 timestamp.",
  "entrypoint": "bot",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}"
  },
  "script": [
    {"op": "log", "message": "Starting"},
    {"op": "log", "message": "Connection slow", "level": "warn"},
    {"op": "log", "message": "Order placed", "data": {"order_id": "o-1", "qty": 2}},
    {"op": "log", "message": "Order failed", "data": {"order_id": "o-2"}, "level": "error"}
  ],
  "expect": {
    "exit_code": 0,
    "stdout": [],
    "stderr": [
      {"level": "info", "message": "Starting", "timestamp": {"$match": "timestamp"}},
      {"level": "warn", "message": "Connection slow", "timestamp": {"$match": "timestamp"}},
      {
        "level": "info",
        "message": "Order placed",
        "order_id": "o-1",
        "qty": 2,
        "timestamp": {"$match": "timestamp"}
      },
      {
        "level": "error",
        "message": "Order failed",
        "order_id": "o-2",
        "timestamp": {"$match": "timestamp"}
      }
    ],
    "result": null
  }
}
