{
  "description": "In query mode a write fails with the read-only error before its key is checked, so even an invalid key gives the read-only error.",
  "entrypoint": "query",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}",
    "QUERY_PATH": "/bad-keys"
  },
  "handlers": {
    "/bad-keys": [
      {"op": "state.set", "key": "../escape", "value": 1, "catch": "read_only_state", "as": "set"},
      {"op": "state.delete", "key": "", "catch": "read_only_state", "as": "delete"},
      {"op": "return", "value": {"set": {"$ref": "set"}, "delete": {"$ref": "delete"}}}
    ]
  },
  "expect": {
    "exit_code": 0,
    "query_result": {
      "status": "ok",
      "data": {"set": {"caught": "read_only_state"}, "delete": {"caught": "read_only_state"}}
    },
    "state_after": {}
  }
}
