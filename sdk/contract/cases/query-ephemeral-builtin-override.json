{
  "description": "A handler the bot registers for a built-in path replaces the built-in.",
  "entrypoint": "query",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}",
    "QUERY_PATH": "/health"
  },
  "handlers": {"/health": [{"op": "return", "value": {"status": "degraded", "feed": "stale"}}]},
  "expect": {
    "exit_code": 0,
    "query_result": {"status": "ok", "data": {"status": "degraded", "feed": "stale"}}
  }
}
