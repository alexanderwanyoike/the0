{
  "description": "metric(type, data) prints one JSON line on stdout: _metric, the data fields and a UTC ISO 8601 timestamp.",
  "entrypoint": "bot",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}"
  },
  "script": [
    {
      "op": "metric",
      "type": "price",
      "data": {"symbol": "BTC/USD", "value": 45000.5, "change_pct": 2.5}
    },
    {
      "op": "metric",
      "type": "signal",
      "data": {"symbol": "ETH/USD", "direction": "long", "tags": ["ma", "rsi"]}
    }
  ],
  "expect": {
    "exit_code": 0,
    "stdout": [
      {
        "_metric": "price",
        "symbol": "BTC/USD",
        "value": 45000.5,
        "change_pct": 2.5,
        "timestamp": {"$match": "timestamp"}
      },
      {
        "_metric": "signal",
        "symbol": "ETH/USD",
        "direction": "long",
        "tags": ["ma", "rsi"],
        "timestamp": {"$match": "timestamp"}
      }
    ],
    "stderr": [],
    "result": null
  }
}
