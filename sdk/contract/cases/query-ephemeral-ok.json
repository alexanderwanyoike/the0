{
  "description": "With QUERY_PATH set, run() calls that handler once, writes {status: ok, data} to the query result file and exits 0. Without QUERY_PARAMS the params are empty.",
  "entrypoint": "query",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}",
    "QUERY_PATH": "/portfolio"
  },
  "state_before": {"positions": [{"symbol": "AAPL", "qty": 100}, {"symbol": "GOOGL", "qty": 50}]},
  "handlers": {
    "/portfolio": [
      {"op": "state.get", "key": "positions", "default": [], "as": "positions"},
      {"op": "query.params", "as": "params"},
      {"op": "return", "value": {"positions": {"$ref": "positions"}, "params": {"$ref": "params"}}}
    ]
  },
  "expect": {
    "exit_code": 0,
    "query_result": {
      "status": "ok",
      "data": {
        "positions": [{"symbol": "AAPL", "qty": 100}, {"symbol": "GOOGL", "qty": 50}],
        "params": {}
      }
    },
    "state_after": {"positions": [{"symbol": "AAPL", "qty": 100}, {"symbol": "GOOGL", "qty": 50}]}
  }
}
