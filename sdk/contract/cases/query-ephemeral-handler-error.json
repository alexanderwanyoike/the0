{
  "description": "A handler that fails writes {status: error, error} with its message and the query exits 1.",
  "entrypoint": "query",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}",
    "QUERY_PATH": "/fail"
  },
  "handlers": {"/fail": [{"op": "raise", "message": "price feed unavailable"}]},
  "expect": {
    "exit_code": 1,
    "query_result": {
      "status": "error",
      "error": {"$match": "contains", "value": "price feed unavailable"}
    }
  }
}
