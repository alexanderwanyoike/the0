{
  "description": "The query server decodes non-ASCII params as UTF-8, from the query string and from a JSON body.",
  "entrypoint": "query",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{}",
    "BOT_TYPE": "realtime",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}",
    "THE0_QUERY_PORT": "{{port}}"
  },
  "handlers": {
    "/echo": [{"op": "query.params", "as": "params"}, {"op": "return", "value": {"$ref": "params"}}]
  },
  "requests": [
    {
      "method": "GET",
      "target": "/echo?symbol=caf%C3%A9+%E2%9C%93",
      "expect": {"status": 200, "body": {"status": "ok", "data": {"symbol": "café ✓"}}}
    },
    {
      "method": "POST",
      "target": "/echo?symbol=caf%C3%A9+%E2%9C%93",
      "body": {"symbol": "café ✓"},
      "expect": {"status": 200, "body": {"status": "ok", "data": {"symbol": "café ✓"}}}
    }
  ]
}
