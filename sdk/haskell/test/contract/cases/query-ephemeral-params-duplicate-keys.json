{
  "description": "A QUERY_PARAMS object that repeats a key neither crashes nor hangs the query.",
  "entrypoint": "query",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{}",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}",
    "QUERY_PATH": "/echo",
    "QUERY_PARAMS": "{\"limit\":5,\"limit\":5}"
  },
  "handlers": {
    "/echo": [{"op": "query.params", "as": "params"}, {"op": "return", "value": {"$ref": "params"}}]
  },
  "expect": {"exit_code": 0, "query_result": {"status": "ok", "data": {"limit": 5}}}
}
