{
  "description": "A bot that writes a success result and then fails with an uncaught error keeps its result and exits 1.",
  "entrypoint": "bot",
  "env": {
    "BOT_ID": "contract-bot",
    "BOT_CONFIG": "{\"symbol\":\"BTC/USD\",\"amount\":100.5}",
    "BOT_TYPE": "scheduled",
    "CODE_MOUNT_DIR": "{{code_mount_dir}}",
    "STATE_DIR": "{{state_dir}}"
  },
  "script": [
    {"op": "success", "message": "Order placed"},
    {"op": "raise", "message": "exchange unreachable"}
  ],
  "expect": {
    "exit_code": 1,
    "stdout": [],
    "result": {"status": "success", "message": "Order placed"}
  }
}
